#!/bin/sh
# WingFoil — the governance check before a push (dl-103 §1 (B), dl-190 (a), task-208, task-366). Required by
# git-conventions §9 and installed once per clone by `npm run setup:hooks` (scripts/install-hooks.cjs, which sets
# core.hooksPath to .githooks). It runs the same script as .github/workflows/governance.yml over the commits about
# to be pushed: scripts/check-governance.cjs, which runs `wingfoil verify` on the code build (node dist/cli.js
# verify, spec-020 §6) and adds this repository's three checks. CI with branch protection on main stays the
# enforcing check.
#
# `git push --no-verify` skips it, and is never used to pass a finding (git-conventions §9). It needs dist/ built
# (`npm run build`): without it the governance check cannot run, so the push is refused (task-366 D7).
#
# git passes the remote's name (or the URL pushed to, when no remote is named) as $1, and one line per pushed ref on
# stdin: <local ref> <local sha> <remote ref> <remote sha>. The range checked is <remote sha>..HEAD for the ref whose
# local sha is HEAD. A new remote ref (all-zero sha, or a remote sha unknown here) is checked from the line the
# branch was cut from (dl-185 C3 (i), git-conventions §9): the merge-base of HEAD with <remote>/main and with each
# <remote>/release/X.Y, the nearest to HEAD winning — for a push to origin, origin/main for a branch of main,
# origin/release/X.Y for a branch of a patch line, origin/main for a new release/X.Y itself. Candidates come from the
# local tracking refs of the remote pushed to, $1, and only when `git remote` lists it (bug-417; a push to a URL has
# none), with no fetch, by full name (refs/remotes/<remote>/main, refs/remotes/<remote>/release/<n>.<n>, so a local
# branch with a look-alike name is never taken for one), in refname order (main first); the tracking ref of the
# pushed ref itself is skipped; a later merge-base replaces the current one only when it differs and the current one
# is its ancestor, so a tie keeps the earlier. No candidate → no base, the whole history (as CI does on a
# branch-creating push). A ref other than HEAD is not checked.
top=$(git rev-parse --show-toplevel) || exit 1
script="$top/scripts/check-governance.cjs"
if [ ! -f "$top/dist/memory/index.js" ]; then
  echo "pre-push: dist/ is not built (npm run build): the governance check cannot run, so the push is refused; build, or push with --no-verify" >&2
  exit 1
fi
remote="$1"
known=""
for name in $(git remote); do
  [ "$name" = "$remote" ] && known=yes
done
head=$(git rev-parse HEAD) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$head" ] || continue
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=""
    candidates=""
    if [ -n "$known" ]; then
      pushed="refs/remotes/$remote/${remote_ref#refs/heads/}"
      candidates=$(git for-each-ref --format='%(refname)' "refs/remotes/$remote/main" "refs/remotes/$remote/release/*")
    fi
    for line in $candidates; do
      case "$line" in
        "refs/remotes/$remote/main") ;;
        "refs/remotes/$remote/release/"*.*)
          version=${line#"refs/remotes/$remote/release/"}
          case "$version" in
            *[!0-9.]* | .* | *. | *.*.* | *..*) continue ;;
          esac
          ;;
        *) continue ;;
      esac
      [ "$line" = "$pushed" ] && continue
      mb=$(git merge-base HEAD "$line" 2>/dev/null) || continue
      if [ -z "$base" ]; then
        base="$mb"
      elif [ "$mb" != "$base" ] && git merge-base --is-ancestor "$base" "$mb" 2>/dev/null; then
        base="$mb"
      fi
    done
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ]; then
    node "$script" --root "$top" --base "$base" || status=$?
  else
    node "$script" --root "$top" || status=$?
  fi
done
exit "$status"
